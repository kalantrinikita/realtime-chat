# Copy to .env to override the defaults used by docker-compose.yml. Never commit .env.

# Port on your machine for the app (http://localhost:8080).
APP_PORT=8080
# Postgres published on 127.0.0.1 only, for IntelliJ runs and integration tests.
DB_PORT=5432
# Only takes effect when the database volume is first created.
DB_PASSWORD=chat-local-only
# Leave empty to allow open sign-up locally. Set it to require a code on the sign-up form.
INVITE_CODE=
COOKIE_SECURE=false
# Extra origins allowed to open the WebSocket (comma-separated). Same-origin always works.
ALLOWED_ORIGINS=

# ---- production only (used with docker-compose.prod.yml) ----
# SITE_ADDRESS=chat.example.com
# DB_PASSWORD=<long random value, e.g. from: openssl rand -base64 32>
# INVITE_CODE=<something you give to the people you invite>
